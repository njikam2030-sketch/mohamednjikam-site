---
import AnalysesPage from '../../../components/pages/AnalysesPage.astro';
import { TOPICS, type Topic } from '../../../config';

export function getStaticPaths() {
  return TOPICS.map((topic) => ({ params: { topic } }));
}
const topic = Astro.params.topic as Topic;
---
<AnalysesPage lang="en" topic={topic} />
