---
import ReflectionPage from '../../../components/pages/ReflectionPage.astro';
import { getReflections, slugOf } from '../../../lib/content';

export async function getStaticPaths() {
  const all = await getReflections();
  return all.filter((e) => e.data.langue === 'fr').map((entry) => ({ params: { slug: slugOf(entry.id) }, props: { entry } }));
}
const { entry } = Astro.props;
---
<ReflectionPage entry={entry} lang="fr" />
