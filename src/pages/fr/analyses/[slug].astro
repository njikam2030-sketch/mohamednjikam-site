---
import ItemPage from '../../../components/pages/ItemPage.astro';
import { getAnalyses } from '../../../lib/content';

export async function getStaticPaths() {
  const all = await getAnalyses();
  return all.filter((e) => e.data.langue === 'fr').map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
---
<ItemPage kind="analysis" entry={entry} />
