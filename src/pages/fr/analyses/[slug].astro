---
import AnalysisPage from '../../../components/pages/AnalysisPage.astro';
import { getAnalyses, slugOf } from '../../../lib/content';

export async function getStaticPaths() {
  const all = await getAnalyses();
  return all.filter((e) => e.data.langue === 'fr').map((entry) => ({ params: { slug: slugOf(entry.id) }, props: { entry } }));
}
const { entry } = Astro.props;
---
<AnalysisPage entry={entry} />
