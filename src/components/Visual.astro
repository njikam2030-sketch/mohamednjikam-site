---
// Vignette d'une publication : sa photo, son graphique, la miniature YouTube ou la couverture du rapport.
// Sans image propre, la photo de sa rubrique (voir TOPIC_PHOTO).
import type { Item } from '../lib/content';

interface Props { item: Item; ratio?: string; eager?: boolean; lang?: string }
const { item, ratio = '16 / 10', eager = false } = Astro.props;
const fit = item.thumb.includes('/charts/') || item.thumb.includes('/covers/');
---
<div class:list={['vis', { contain: fit, cover: item.thumb.includes('/covers/') }]} style={`aspect-ratio:${ratio}`}>
  <img src={item.thumb} alt="" loading={eager ? 'eager' : 'lazy'} />
  {item.kind === 'video' && <span class="play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5z" fill="currentColor"/></svg></span>}
</div>

<style>
  .vis { position: relative; width: 100%; overflow: hidden; border-radius: 8px; background: var(--soft); }
  .vis img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .contain { background: var(--white); border: 1px solid var(--line); }
  .contain img { object-fit: contain; padding: 6px; }
  .cover { background: linear-gradient(135deg, #E9EEF5, #F7F9FC); }
  .cover img { padding: 10px; filter: drop-shadow(0 4px 10px rgba(15, 23, 42, 0.18)); }
  .play { position: absolute; left: 10px; bottom: 10px; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--red); color: #fff; }
  .play svg { width: 18px; height: 18px; margin-left: 2px; }
  :global(a:hover) > .vis img, :global(.c:hover) .vis img { transform: scale(1.04); }
</style>
