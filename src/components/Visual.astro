---
// Vignette d'une publication : son image (photo, graphique ou miniature YouTube). Rien si elle n'en a pas.
import type { Item } from '../lib/content';

interface Props { item: Item; ratio?: string; eager?: boolean; lang?: string }
const { item, ratio = '16 / 9', eager = false } = Astro.props;
---
{item.image && (
  <div class:list={['vis', { contain: item.image.includes('/charts/') }]} style={ratio === 'auto' ? undefined : `aspect-ratio:${ratio}`}>
    <img src={item.image} alt="" loading={eager ? 'eager' : 'lazy'} />
    {item.kind === 'video' && <span class="play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5z" fill="currentColor"/></svg></span>}
  </div>
)}

<style>
  .vis { position: relative; width: 100%; overflow: hidden; background: var(--soft); }
  .vis img { width: 100%; height: 100%; object-fit: cover; }
  .contain { background: var(--white); outline: 1px solid var(--line); outline-offset: -1px; }
  .contain img { object-fit: contain; padding: 4px; }
  .vis:not([style]) img { height: auto; }
  .play { position: absolute; left: 12px; bottom: 12px; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: rgba(13, 27, 42, 0.85); color: #fff; }
  .play svg { width: 18px; height: 18px; margin-left: 2px; }
</style>
