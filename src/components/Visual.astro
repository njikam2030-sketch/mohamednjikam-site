---
// Vignette d'une publication : son image si elle en a une, sinon un panneau sobre (type + rubrique) ou la citation.
import { KIND_NAME, TOPIC_INFO, type Lang } from '../i18n/ui';
import type { Item } from '../lib/content';

interface Props { item: Item; lang: Lang; ratio?: string; eager?: boolean }
const { item, lang, ratio = '16 / 9', eager = false } = Astro.props;
const topic = item.topics[0];
---
{item.image ? (
  <div class="vis img" style={`aspect-ratio:${ratio}`}><img src={item.image} alt="" loading={eager ? 'eager' : 'lazy'} /></div>
) : item.kind === 'commentary' ? (
  <div class="vis quote" style={`aspect-ratio:${ratio}`}>{item.quote && <span class="q" aria-hidden="true">{'“'}</span>}<p>{(() => { const s = (item.quote ?? item.title).replace(/^“|”$/g, ''); return s.length > 120 ? s.slice(0, 120).replace(/\s+\S*$/, '') + '…' : s; })()}</p></div>
) : (
  <div class:list={['vis', 'plain', item.kind]} style={`aspect-ratio:${ratio}`}>
    <span class="k">{KIND_NAME[item.kind][lang]}</span>
    <span class="t">{topic ? TOPIC_INFO[topic][lang] : ''}</span>
  </div>
)}

<style>
  .vis { width: 100%; max-width: 100%; overflow: hidden; border-radius: 4px; background: var(--soft); }
  .img img { width: 100%; height: 100%; object-fit: cover; }
  .plain { display: grid; align-content: space-between; padding: 18px 20px; background: var(--navy); color: var(--white); }
  .plain.commentary { background: #12395F; }
  .plain.chart { background: #0B5CAD; }
  .k { font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #A9C2DE; }
  .t { font-size: clamp(20px, 2.4vw, 28px); font-weight: 800; letter-spacing: -0.02em; line-height: 1.15; }
  .quote { display: grid; align-content: center; padding: 22px 24px; background: var(--blue-light); color: var(--navy); }
  .quote .q { font-size: 64px; line-height: 0.6; font-weight: 800; color: var(--blue); height: 28px; }
  .quote p { font-size: 18px; font-weight: 600; line-height: 1.4; }
</style>
