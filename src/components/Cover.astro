---
// Couverture d'une analyse : la photo choisie, sinon le chiffre clé en très grand, sinon la rubrique.
import { TOPIC_NAMES, type Lang } from '../i18n/ui';
import type { Analysis } from '../lib/content';

interface Props { entry: Analysis; lang: Lang; size?: 'large' | 'small' | 'hero' }
const { entry, lang, size = 'small' } = Astro.props;
const d = entry.data;
// Couleur de fond selon la rubrique (nuances de la charte)
const tone = { uk: 'brown', africa: 'olive', asia: 'ink', ai: 'ink', markets: 'brown', payments: 'beige', debt: 'ink' }[d.rubrique];
---
{d.couverture ? (
  <div class:list={['cover', 'photo', size]}><img src={d.couverture} alt="" loading={size === 'hero' ? 'eager' : 'lazy'} /></div>
) : (
  <div class:list={['cover', tone, size]} aria-hidden="true">
    <span class="big">{d.chiffreCle ?? ''}</span>
    <span class="tag">{TOPIC_NAMES[d.rubrique][lang]}</span>
  </div>
)}

<style>
  .cover { position: relative; overflow: hidden; border-radius: 3px; aspect-ratio: 16 / 9; width: 100%; max-width: 100%; display: grid; align-content: end; padding: 14px 16px; background: var(--brown); color: var(--cream); }
  .hero { aspect-ratio: 21 / 9; }
  .photo { padding: 0; }
  .photo img { width: 100%; height: 100%; object-fit: cover; }
  .big { position: absolute; left: 14px; top: 6px; font-weight: 900; line-height: 1; letter-spacing: -0.05em; white-space: nowrap; color: var(--accent); font-size: clamp(56px, 12vw, 104px); }
  .large .big { font-size: clamp(76px, 15vw, 170px); }
  .hero .big { font-size: clamp(80px, 19vw, 230px); }
  .tag { position: relative; font-size: 11px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--beige); }
  .olive { background: var(--olive); } .olive .big { color: var(--paper); }
  .ink { background: var(--ink); }
  .beige { background: var(--beige); } .beige .big { color: var(--accent); } .beige .tag { color: var(--brown); }
</style>
