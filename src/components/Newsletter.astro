---
// Bandeau d'inscription à la newsletter (Buttondown), présent en bas de chaque page.
import { SITE } from '../config';
import { UI, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = UI[lang];
const action = SITE.buttondown ? `https://buttondown.com/api/emails/embed-subscribe/${SITE.buttondown}` : '';
---
<section class="nl" id="newsletter">
  <div class="wrap nl-in">
    <div>
      <h2>{t.nlTitle}</h2>
      <p>{t.nlText}</p>
    </div>
    {action ? (
      <form action={action} method="post" target="_blank">
        <label class="sr" for={`nl-${lang}`}>{t.email}</label>
        <input id={`nl-${lang}`} type="email" name="email" required placeholder={t.email} autocomplete="email" />
        <input type="hidden" name="tag" value={lang} />
        <button class="btn btn-primary" type="submit">{t.nlButton}</button>
      </form>
    ) : (
      <p class="soon">{t.nlSoon}</p>
    )}
  </div>
</section>

<style>
  .nl { background: var(--soft); border-top: 1px solid var(--line); }
  .nl-in { display: grid; gap: 20px; align-items: center; padding-block: 44px; }
  h2 { font-size: 26px; }
  p { color: var(--muted); margin-top: 6px; }
  form { display: flex; flex-wrap: wrap; gap: 10px; }
  input[type=email] { flex: 1 1 240px; min-width: 0; font: 16px var(--font); padding: 11px 14px; border: 1px solid #BDBDBD; border-radius: 2px; background: var(--white); color: var(--ink); }
  input[type=email]:focus { outline: none; border-color: var(--blue); box-shadow: 0 0 0 3px rgba(11, 92, 173, 0.15); }
  .soon { font-weight: 600; color: var(--ink); }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  @media (min-width: 860px) { .nl-in { grid-template-columns: 1fr 1fr; gap: 48px; } }
</style>
