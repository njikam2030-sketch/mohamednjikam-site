---
// Carte d'une analyse : couverture (image ou chiffre clé), rubrique, titre, date, temps de lecture.
import { UI, TOPIC_NAMES, formatDate, path, readingTime, type Lang } from '../i18n/ui';
import { slugOf, type Analysis } from '../lib/content';
import Cover from './Cover.astro';

interface Props { entry: Analysis; lang: Lang; size?: 'large' | 'small' | 'line' }
const { entry, lang, size = 'small' } = Astro.props;
const d = entry.data;
const t = UI[lang];
const href = path.analysis(d.langue, slugOf(entry.id));
---
<a class:list={['card', size]} href={href}>
  {size !== 'line' && <Cover entry={entry} lang={lang} size={size} />}
  <div class="txt">
    <span class="eyebrow">
      {TOPIC_NAMES[d.rubrique][lang]}{d.rubrique2 && ` · ${TOPIC_NAMES[d.rubrique2][lang]}`}
      {d.langue !== lang && <span class="badge">{d.langue.toUpperCase()}</span>}
      {d.modele && <span class="badge">{t.template}</span>}
    </span>
    <h3>{d.titre}</h3>
    {size === 'large' && d.sousTitre && <p class="sub">{d.sousTitre}</p>}
    <span class="meta">{formatDate(d.date, lang)} · {readingTime(entry.body)} {t.minRead}</span>
  </div>
</a>

<style>
  .card { display: grid; gap: 12px; text-decoration: none; min-width: 0; }
  .txt { display: grid; gap: 6px; min-width: 0; }
  .eyebrow { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
  h3 { font-size: 20px; font-weight: 800; line-height: 1.2; }
  .large h3 { font-size: clamp(26px, 4.6vw, 40px); font-weight: 900; line-height: 1.05; }
  .sub { margin: 0; font-size: 18px; color: var(--brown); }
  .line { padding-block: 12px; border-bottom: 1px solid var(--line); }
  .line h3 { font-size: 17px; }
  .card:hover h3 { color: var(--accent); }
</style>
