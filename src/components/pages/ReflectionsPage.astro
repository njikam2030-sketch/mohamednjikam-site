---
// Toutes les réflexions (le fil complet).
import Base from '../../layouts/Base.astro';
import PostCard from '../PostCard.astro';
import Sidebar from '../Sidebar.astro';
import { UI, path, type Lang } from '../../i18n/ui';
import { getReflections, getAnalysesFor } from '../../lib/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = UI[lang];
const reflections = await getReflections();
const analyses = await getAnalysesFor(lang);
---
<Base lang={lang} title={t.reflections} section="reflections" alternate={path.reflections(lang === 'en' ? 'fr' : 'en')}>
  <div class="gutter">
    <div class="wide layout">
      <main class="feed">
        <h1 class="title">{t.reflections}</h1>
        {reflections.length === 0 && <p class="empty">{t.noReflections}</p>}
        {reflections.map((r) => <PostCard entry={r} lang={lang} />)}
      </main>
      <Sidebar lang={lang} analyses={analyses} />
    </div>
  </div>
</Base>

<style>
  .layout { display: grid; gap: 40px; }
  .feed { min-width: 0; }
  .title { font-size: clamp(32px, 6vw, 48px); font-weight: 900; letter-spacing: -0.04em; padding-block: 32px 8px; border-bottom: 3px solid var(--ink); }
  @media (min-width: 960px) { .layout { grid-template-columns: minmax(0, 640px) 1fr; gap: 56px; } }
</style>
