---
// Page d'une publication (analyse, réflexion, graphique, vidéo ou rapport PDF).
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Card from '../Card.astro';
import Share from '../Share.astro';
import { SITE } from '../../config';
import { UI, KIND_NAME, TOPIC_INFO, formatDate, other, path, readingTime, type Lang } from '../../i18n/ui';
import { allItems, analysisItem, chartItem, reflectionItem, reportItem, videoItem, type Analysis, type Chart, type Reflection, type Report, type Video } from '../../lib/content';
import { countryName } from '../../data/countries';
import profil from '../../data/profil.json';
import { ogPath } from '../../lib/og';

type Props =
  | { kind: 'analysis'; entry: Analysis }
  | { kind: 'commentary'; entry: Reflection }
  | { kind: 'chart'; entry: Chart }
  | { kind: 'video'; entry: Video }
  | { kind: 'report'; entry: Report };
const props = Astro.props;
const { kind } = props;
const item = props.kind === 'analysis' ? analysisItem(props.entry) : props.kind === 'commentary' ? reflectionItem(props.entry) : props.kind === 'chart' ? chartItem(props.entry) : props.kind === 'video' ? videoItem(props.entry) : reportItem(props.entry);
const lang: Lang = item.lang;
const t = UI[lang];
const p = profil[lang];
const { Content } = await render(props.entry);
const url = new URL(item.href, SITE.url).href;
const analysis = props.kind === 'analysis' ? props.entry.data : undefined;
const reflection = props.kind === 'commentary' ? props.entry.data : undefined;
const chart = props.kind === 'chart' ? props.entry.data : undefined;
const video = props.kind === 'video' ? props.entry.data : undefined;
const report = props.kind === 'report' ? props.entry.data : undefined;
const keyPoints = analysis?.pointsCles ?? video?.pointsCles ?? [];
const hasBody = !!props.entry.body?.trim();
const alternate = analysis?.traduction ? path.item(other(lang), 'analysis', analysis.traduction) : path.list(other(lang), kind);
const related = (await allItems(lang))
  .filter((i) => i.href !== item.href)
  .sort((a, b) => Number(b.topics.some((x) => item.topics.includes(x))) - Number(a.topics.some((x) => item.topics.includes(x))))
  .slice(0, 3);
const listTitle = { analysis: t.analysis, commentary: t.commentary, chart: t.charts, video: t.videos, report: t.reports }[kind];
const description = item.excerpt ?? (reflection?.citation ? `${reflection.citation} ${reflection.auteur ?? ''}` : p.bio);
---
<Base lang={lang} title={item.title} description={description} image={props.kind === 'analysis' ? ogPath(item) : item.image ?? ogPath(item)} type="article" date={item.date} alternate={alternate} section={kind}>
  <article>
    <header class="head">
      <div class="wrap">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href={path.home(lang)}>{t.breadcrumbHome}</a><span aria-hidden="true">/</span>
          <a href={path.list(lang, kind)}>{listTitle}</a>
        </nav>
        <div class="read" data-pagefind-body>
          <div class="labels">
            <span class="label label-kind">{KIND_NAME[kind][lang]}</span>
            {item.topics.map((tp) => <a class="pill" href={path.topic(lang, tp)}>{TOPIC_INFO[tp][lang]}</a>)}
            {item.coming && <span class="badge">{t.coming}</span>}
          </div>
          {kind === 'commentary' && reflection?.citation ? (
            <blockquote class="bigquote">
              <p>{`“${reflection.citation}”`}</p>
              {reflection.auteur && <cite>{reflection.auteur}</cite>}
            </blockquote>
          ) : (
            <h1 data-pagefind-meta="title">{kind === 'commentary' && !reflection?.titre ? '' : item.title}</h1>
          )}
          {(analysis?.chapeau ?? report?.chapeau) && <p class="lede">{analysis?.chapeau ?? report?.chapeau}</p>}
          {item.countries.length > 0 && (
            <p class="countries">{item.countries.map((c) => <a href={path.country(lang, c)}>{countryName(c, lang)}</a>)}</p>
          )}
          <div class="byline">
            <img src="/images/avatar.jpg" alt="" width="44" height="44" />
            <div>
              <span>{t.by} <a href={path.about(lang)}>{SITE.name}</a></span>
              <span class="date"><time datetime={item.date.toISOString()}>{formatDate(item.date, lang)}</time>{kind === 'analysis' && !item.coming && <> · {readingTime(props.entry.body)} {t.minRead}</>}</span>
            </div>
            {analysis?.linkedin && <a class="alt li" href={analysis.linkedin} target="_blank" rel="noopener">{t.alsoOn}</a>}
            {analysis?.traduction && <a class="alt" href={alternate}>{lang === 'en' ? 'Version française' : 'English version'}</a>}
          </div>
        </div>
      </div>
    </header>

    {(analysis?.image || reflection?.image) && !(analysis?.image ?? '').includes('/charts/') && (
      <figure class="wrap cover">
        <img src={analysis?.image ?? reflection?.image} alt="" />
        {analysis?.legendeImage && <figcaption>{analysis.legendeImage}</figcaption>}
      </figure>
    )}

    <div class="wrap">
      <div class="read body">
        {video && (
          <div class="yt" data-yt={item.youtubeId}>
            <button type="button" class="yt-play" aria-label={t.watch}>
              <img src={item.image} alt="" />
              <span class="yt-btn" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5z" fill="currentColor"/></svg></span>
            </button>
          </div>
        )}
        {video && (
          <p class="yt-meta">
            {item.mine ? <span class="badge">{t.myVideo}</span> : video.chaine && <span>{video.chaine}</span>}
            <a href={`https://www.youtube.com/watch?v=${item.youtubeId}`} target="_blank" rel="noopener">{t.watchOn}</a>
          </p>
        )}
        {report && (
          <div class="pdfbox">
            <div class="pdf-actions">
              <a class="btn btn-primary" href={report.pdf} download>{t.downloadPdf}</a>
              <a class="btn btn-outline" href={report.pdf} target="_blank" rel="noopener">{t.openPdf}</a>
              {report.pages && <span class="date">{report.pages} {t.pagesLabel}</span>}
            </div>
            <object class="pdfview" data={`${report.pdf}#view=FitH`} type="application/pdf" aria-label={item.title}>
              <p class="date">{t.openPdf} : <a href={report.pdf}>{item.title}</a></p>
            </object>
          </div>
        )}
        {chart && (
          <figure class="chartfig">
            <img src={chart.image} alt={item.title} />
            {chart.source && <figcaption><strong>{t.source} :</strong> {chart.source}</figcaption>}
          </figure>
        )}
        {keyPoints.length > 0 && (
          <aside class="keys">
            <h2>{t.keyPoints}</h2>
            <ul>{keyPoints.map((k) => <li>{k}</li>)}</ul>
          </aside>
        )}
        {item.coming && <p class="coming">{t.comingText} <a href="#newsletter">{t.subscribe}</a></p>}
        {video ? (
          hasBody && (
            <div class="vcomment">
              <img src="/images/avatar.jpg" alt="" width="40" height="40" />
              <div>
                <span class="vc-label">{t.myTake} · {SITE.name}</span>
                <div class="prose short" data-pagefind-body><Content /></div>
              </div>
            </div>
          )
        ) : (
          <div class:list={['prose', { short: kind === 'commentary' }]} data-pagefind-body><Content /></div>
        )}
        <div class="share">
          <Share lang={lang} url={url} text={item.title} />
          {kind === 'analysis' && !item.coming && <button type="button" class="pdf" onclick="window.print()">{t.pdf}</button>}
        </div>
        <div class="author">
          <img src="/images/avatar.jpg" alt="" width="64" height="64" />
          <div><strong><a href={path.about(lang)}>{SITE.name}</a></strong><p>{p.bio}</p></div>
        </div>
      </div>
    </div>
  </article>

  {related.length > 0 && (
    <section class="section grey">
      <div class="wrap">
        <div class="section-head"><h2>{t.related}</h2></div>
        <div class="grid3">{related.map((i) => <Card item={i} lang={lang} />)}</div>
      </div>
    </section>
  )}
</Base>

<script>
  // Vidéo YouTube : chargée seulement au clic (page plus rapide, aucun suivi avant le clic)
  document.querySelectorAll<HTMLElement>('[data-yt]').forEach((box) => {
    box.querySelector('button')?.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = `https://www.youtube-nocookie.com/embed/${box.dataset.yt}?autoplay=1&rel=0`;
      f.title = 'YouTube';
      f.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      f.allowFullscreen = true;
      box.replaceChildren(f);
    });
  });
</script>

<style>
  .head { border-bottom: 1px solid var(--line); padding-block: 28px 32px; }
  .crumbs { margin-bottom: 26px; }
  .read { margin: 0 auto; }
  .labels { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 14px; }
  .labels a { text-decoration: none; } .labels a:hover { text-decoration: underline; }
  h1 { font-size: clamp(32px, 5vw, 50px); line-height: 1.08; letter-spacing: -0.015em; margin-top: 14px; }
  h1:empty { display: none; }
  .lede { font-family: var(--serif); font-size: 22px; line-height: 1.45; color: var(--muted); margin-top: 16px; }
  .bigquote { margin: 18px 0 0; padding: 0; }
  .bigquote p { font-family: var(--serif); font-style: italic; font-size: clamp(28px, 3.8vw, 38px); line-height: 1.25; font-weight: 600; color: var(--ink); }
  .bigquote cite { display: block; margin-top: 14px; font-style: normal; font-size: 15px; color: var(--muted); }
  .byline { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-top: 24px; font-size: 15px; }
  .byline img { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; }
  .byline span { display: block; }
  .byline a { color: var(--ink); text-decoration: none; font-weight: 600; }
  .byline a:hover { text-decoration: underline; }
  .byline .alt { margin-left: auto; font-size: 13px; border: 1px solid var(--line); border-radius: 2px; padding: 6px 12px; color: var(--ink); font-weight: 500; }
  .alt:hover { border-color: var(--ink); }
  .cover { margin-block: 32px 0; }
  .cover img { width: 100%; max-height: 560px; object-fit: cover; }
  .cover figcaption { font-size: 14px; color: var(--muted); margin-top: 8px; }
  .body { padding-block: 36px 56px; }
  .chartfig { margin: 0 0 28px; }
  .chartfig img { width: 100%; border: 1px solid var(--line); }
  .chartfig figcaption { font-size: 14px; color: var(--muted); margin-top: 10px; }
  .yt { position: relative; aspect-ratio: 16 / 9; background: #000; overflow: hidden; }
  .yt-play { all: unset; cursor: pointer; display: block; width: 100%; height: 100%; position: relative; }
  .yt-play img { width: 100%; height: 100%; object-fit: cover; }
  .yt-btn { position: absolute; inset: 0; margin: auto; width: 76px; height: 76px; border-radius: 50%; display: grid; place-items: center; background: rgba(10, 37, 64, 0.9); color: #fff; }
  .yt-btn svg { width: 34px; height: 34px; margin-left: 4px; }
  .yt-play:hover .yt-btn, .yt-play:focus-visible .yt-btn { background: var(--blue); }
  .yt :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .countries { display: flex; flex-wrap: wrap; gap: 4px 14px; margin-top: 16px; }
  .countries a { font-size: 13px; font-weight: 500; color: var(--muted); text-decoration: underline; text-decoration-color: var(--line); text-underline-offset: 3px; }
  .countries a:hover { color: var(--ink); text-decoration-color: currentColor; }
  .pdfbox { display: grid; gap: 16px; margin-bottom: 32px; }
  .pdf-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .pdfview { width: 100%; height: min(80vh, 900px); border: 1px solid var(--line); border-radius: 4px; background: var(--soft); }
  .yt-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; margin: 12px 0 28px; font-size: 14px; color: var(--muted); }
  .yt-meta a { color: var(--blue); font-weight: 600; }
  .vcomment { display: grid; grid-template-columns: 40px 1fr; gap: 14px; border-top: 2px solid var(--rule); padding-top: 16px; margin-top: 4px; }
  .vcomment img { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; }
  .vc-label { display: block; font-size: 12px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--faint); margin-bottom: 6px; }
  .vcomment .prose { font-size: 19px; line-height: 1.55; }
  .take { font-size: 13px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--navy); margin: 8px 0 14px; padding-top: 18px; border-top: 1px solid var(--line); }
  .keys { border-top: 2px solid var(--rule); border-bottom: 1px solid var(--line); padding: 14px 0 18px; margin-bottom: 32px; }
  .keys h2 { font-family: var(--font); font-size: 12px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink); }
  .keys ul { margin: 10px 0 0; padding-left: 1.1em; display: grid; gap: 8px; font-family: var(--serif); font-size: 18px; line-height: 1.45; }
  .keys li::marker { color: var(--faint); }
  .coming { background: var(--soft); padding: 18px 20px; color: var(--muted); margin-bottom: 24px; }
  .coming a { color: var(--blue); font-weight: 600; }
  .prose.short { font-size: 20px; }
  .share { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; margin-top: 44px; padding-top: 24px; border-top: 1px solid var(--line); }
  .pdf { font: 600 13px var(--font); color: var(--ink); background: none; border: 1px solid var(--ink); border-radius: 2px; padding: 7px 14px; cursor: pointer; }
  .pdf:hover { background: var(--ink); color: var(--white); }
  .author { display: grid; grid-template-columns: 64px 1fr; gap: 16px; align-items: center; margin-top: 28px; padding-top: 22px; border-top: 1px solid var(--line); }
  .author img { width: 64px; height: 64px; border-radius: 50%; object-fit: cover; }
  .author a { text-decoration: none; color: var(--ink); font-family: var(--serif); font-size: 19px; }
  .author p { font-size: 15px; color: var(--muted); margin-top: 2px; }
  .grid3 { display: grid; gap: 36px 28px; }
  @media (min-width: 680px) { .grid3 { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .grid3 { grid-template-columns: repeat(3, 1fr); } }
</style>
