---
// Page d'une publication (analyse, réflexion ou graphique).
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Card from '../Card.astro';
import Share from '../Share.astro';
import { SITE } from '../../config';
import { UI, KIND_NAME, TOPIC_INFO, formatDate, other, path, readingTime, type Lang } from '../../i18n/ui';
import { allItems, analysisItem, chartItem, reflectionItem, type Analysis, type Chart, type Reflection } from '../../lib/content';
import profil from '../../data/profil.json';
import { ogPath } from '../../lib/og';

type Props =
  | { kind: 'analysis'; entry: Analysis }
  | { kind: 'commentary'; entry: Reflection }
  | { kind: 'chart'; entry: Chart };
const props = Astro.props;
const { kind } = props;
const item = props.kind === 'analysis' ? analysisItem(props.entry) : props.kind === 'commentary' ? reflectionItem(props.entry) : chartItem(props.entry);
const lang: Lang = item.lang;
const t = UI[lang];
const p = profil[lang];
const { Content } = await render(props.entry);
const url = new URL(item.href, SITE.url).href;
const analysis = props.kind === 'analysis' ? props.entry.data : undefined;
const reflection = props.kind === 'commentary' ? props.entry.data : undefined;
const chart = props.kind === 'chart' ? props.entry.data : undefined;
const alternate = analysis?.traduction ? path.item(other(lang), 'analysis', analysis.traduction) : path.list(other(lang), kind);
const related = (await allItems(lang))
  .filter((i) => i.href !== item.href)
  .sort((a, b) => Number(b.topics.some((x) => item.topics.includes(x))) - Number(a.topics.some((x) => item.topics.includes(x))))
  .slice(0, 3);
const listTitle = kind === 'analysis' ? t.analysis : kind === 'commentary' ? t.commentary : t.charts;
const description = item.excerpt ?? (reflection?.citation ? `${reflection.citation} ${reflection.auteur ?? ''}` : p.bio);
---
<Base lang={lang} title={item.title} description={description} image={item.image ?? ogPath(item)} type="article" date={item.date} alternate={alternate} section={kind}>
  <article>
    <header class="head">
      <div class="wrap">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href={path.home(lang)}>{t.breadcrumbHome}</a><span aria-hidden="true">/</span>
          <a href={path.list(lang, kind)}>{listTitle}</a>
        </nav>
        <div class="read">
          <div class="labels">
            <span class="label label-kind">{KIND_NAME[kind][lang]}</span>
            {item.topics.map((tp) => <a class="label" href={path.topic(lang, tp)}>{TOPIC_INFO[tp][lang]}</a>)}
            {item.coming && <span class="badge">{t.coming}</span>}
          </div>
          {kind === 'commentary' && reflection?.citation ? (
            <blockquote class="bigquote">
              <p>{`“${reflection.citation}”`}</p>
              {reflection.auteur && <cite>{reflection.auteur}</cite>}
            </blockquote>
          ) : (
            <h1 data-pagefind-meta="title">{kind === 'commentary' && !reflection?.titre ? '' : item.title}</h1>
          )}
          {analysis?.chapeau && <p class="lede">{analysis.chapeau}</p>}
          <div class="byline">
            <img src="/images/avatar.jpg" alt="" width="44" height="44" />
            <div>
              <span>{t.by} <a href={path.about(lang)}>{SITE.name}</a></span>
              <span class="date"><time datetime={item.date.toISOString()}>{formatDate(item.date, lang)}</time>{kind === 'analysis' && !item.coming && <> · {readingTime(props.entry.body)} {t.minRead}</>}</span>
            </div>
            {analysis?.traduction && <a class="alt" href={alternate}>{lang === 'en' ? 'Version française' : 'English version'}</a>}
          </div>
        </div>
      </div>
    </header>

    {(analysis?.image || reflection?.image) && (
      <figure class="wrap cover">
        <img src={analysis?.image ?? reflection?.image} alt="" />
        {analysis?.legendeImage && <figcaption>{analysis.legendeImage}</figcaption>}
      </figure>
    )}

    <div class="wrap">
      <div class="read body">
        {chart && (
          <figure class="chartfig">
            <img src={chart.image} alt={item.title} />
            {chart.source && <figcaption><strong>{t.source} :</strong> {chart.source}</figcaption>}
          </figure>
        )}
        {analysis && analysis.pointsCles.length > 0 && (
          <aside class="keys">
            <h2>{t.keyPoints}</h2>
            <ul>{analysis.pointsCles.map((k) => <li>{k}</li>)}</ul>
          </aside>
        )}
        {item.coming && <p class="coming">{t.comingText} <a href="#newsletter">{t.subscribe}</a></p>}
        <div class:list={['prose', { short: kind === 'commentary' }]} data-pagefind-body><Content /></div>
        <div class="share">
          <Share lang={lang} url={url} text={item.title} />
          {kind === 'analysis' && !item.coming && <button type="button" class="pdf" onclick="window.print()">{t.pdf}</button>}
        </div>
        <div class="author">
          <img src="/images/avatar.jpg" alt="" width="64" height="64" />
          <div><strong><a href={path.about(lang)}>{SITE.name}</a></strong><p>{p.titre}. {p.bio}</p></div>
        </div>
      </div>
    </div>
  </article>

  {related.length > 0 && (
    <section class="section grey">
      <div class="wrap">
        <div class="section-head"><h2>{t.related}</h2></div>
        <div class="grid3">{related.map((i) => <Card item={i} lang={lang} />)}</div>
      </div>
    </section>
  )}
</Base>

<style>
  .head { border-bottom: 1px solid var(--line); padding-block: 28px 32px; }
  .crumbs { margin-bottom: 26px; }
  .read { margin: 0 auto; }
  .labels { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 14px; }
  .labels a { text-decoration: none; } .labels a:hover { text-decoration: underline; }
  h1 { font-size: clamp(32px, 5vw, 48px); font-weight: 800; line-height: 1.1; letter-spacing: -0.03em; margin-top: 16px; color: var(--navy); }
  h1:empty { display: none; }
  .lede { font-size: 21px; line-height: 1.55; color: var(--muted); margin-top: 16px; }
  .bigquote { margin: 18px 0 0; padding: 0; }
  .bigquote p { font-size: clamp(26px, 3.6vw, 34px); line-height: 1.3; font-weight: 700; letter-spacing: -0.02em; color: var(--navy); }
  .bigquote cite { display: block; margin-top: 12px; font-style: normal; font-weight: 600; color: var(--blue); }
  .byline { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-top: 24px; font-size: 15px; }
  .byline img { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; }
  .byline span { display: block; }
  .byline a { color: var(--blue); text-decoration: none; font-weight: 600; }
  .byline .alt { margin-left: auto; font-size: 14px; border: 1px solid #CBD5E1; border-radius: 4px; padding: 6px 12px; color: var(--ink); font-weight: 500; }
  .cover { margin-block: 32px 0; }
  .cover img { width: 100%; max-height: 560px; object-fit: cover; border-radius: 4px; }
  .cover figcaption { font-size: 14px; color: var(--muted); margin-top: 8px; }
  .body { padding-block: 36px 56px; }
  .chartfig { margin: 0 0 28px; }
  .chartfig img { width: 100%; border: 1px solid var(--line); border-radius: 4px; }
  .chartfig figcaption { font-size: 14px; color: var(--muted); margin-top: 10px; }
  .keys { background: var(--blue-light); border-left: 4px solid var(--blue); border-radius: 0 4px 4px 0; padding: 20px 24px; margin-bottom: 32px; }
  .keys h2 { font-size: 13px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--navy); }
  .keys ul { margin: 12px 0 0; padding-left: 1.2em; display: grid; gap: 8px; font-size: 17px; }
  .keys li::marker { color: var(--blue); }
  .coming { background: var(--soft); border: 1px solid var(--line); border-radius: 4px; padding: 18px 20px; color: var(--muted); margin-bottom: 24px; }
  .coming a { color: var(--blue); font-weight: 600; }
  .prose.short { font-size: 20px; }
  .share { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; margin-top: 44px; padding-top: 24px; border-top: 1px solid var(--line); }
  .pdf { font: 600 14px var(--font); color: var(--white); background: var(--navy); border: 0; border-radius: 4px; padding: 8px 16px; cursor: pointer; }
  .pdf:hover { background: var(--blue); }
  .author { display: grid; grid-template-columns: 64px 1fr; gap: 16px; align-items: center; margin-top: 28px; padding: 22px; background: var(--soft); border-radius: 4px; }
  .author img { width: 64px; height: 64px; border-radius: 50%; object-fit: cover; }
  .author a { text-decoration: none; color: var(--navy); }
  .author p { font-size: 15px; color: var(--muted); margin-top: 2px; }
  .grid3 { display: grid; gap: 36px 28px; }
  @media (min-width: 680px) { .grid3 { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .grid3 { grid-template-columns: repeat(3, 1fr); } }
</style>
