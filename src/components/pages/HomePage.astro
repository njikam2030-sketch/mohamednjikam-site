---
// Accueil (et éditions par pays) organisé comme une une de journal :
// dernière minute, grande une + articles secondaires + colonne de réflexions, vidéos, rubriques, l'auteur.
import Base from '../../layouts/Base.astro';
import Card from '../Card.astro';
import Visual from '../Visual.astro';
import { SITE, TOPICS } from '../../config';
import { UI, KIND_NAME, TOPIC_INFO, REGION_NAME, formatDate, other, path, type Lang, type Region } from '../../i18n/ui';
import { allItems, type Item } from '../../lib/content';
import profil from '../../data/profil.json';

interface Props { lang: Lang; edition?: Region }
const { lang, edition } = Astro.props;
const t = UI[lang];
const p = profil[lang];
const everything = await allItems(lang);
const items = edition ? everything.filter((i) => i.topics.includes(edition)) : everything;

const analyses = items.filter((i) => i.kind === 'analysis');
const lead = analyses.find((i) => i.featured) ?? analyses[0] ?? items[0];
const secondary = items.filter((i) => i !== lead && (i.kind === 'analysis' || i.kind === 'chart')).slice(0, 2);
const reflections = items.filter((i) => i.kind === 'commentary').slice(0, 5);
const videos = items.filter((i) => i.kind === 'video').slice(0, 4);
const ticker = everything.slice(0, 6);
const shown = new Set<Item>([lead, ...secondary].filter(Boolean));
// Une rangée par rubrique, sans répéter ce qui est déjà affiché plus haut (les vidéos ont leur bandeau)
const sections: { tp: (typeof TOPICS)[number]; list: Item[] }[] = [];
for (const tp of TOPICS.filter((x) => x !== edition)) {
  const list = items.filter((i) => i.topics.includes(tp) && i.kind !== 'commentary' && i.kind !== 'video' && !shown.has(i)).slice(0, 4);
  list.forEach((i) => shown.add(i));
  if (list.length > 0) sections.push({ tp, list });
}
const title = edition ? `${REGION_NAME[edition][lang]} ${t.edition}` : undefined;
const alt = edition ? path.edition(other(lang), edition) : path.home(other(lang));
---
<Base lang={lang} title={title} section="home" edition={edition} alternate={alt}>

  <!-- Dernière minute -->
  {ticker.length > 0 && (
    <div class="ticker">
      <div class="wrap ticker-in">
        <span class="tk-label">{t.latestNews}</span>
        <ul>{ticker.map((i) => <li><a href={i.href}>{i.title}</a></li>)}</ul>
      </div>
    </div>
  )}

  {edition && (
    <div class="wrap ed-head">
      <span class="label">{t.edition}</span>
      <h1>{TOPIC_INFO[edition][lang]}</h1>
      <p>{lang === 'fr' ? TOPIC_INFO[edition].dfr : TOPIC_INFO[edition].den}</p>
    </div>
  )}

  <!-- À la une -->
  <section class="wrap front">
    {!lead && <p class="empty">{t.emptyHome}</p>}
    {lead && (
      <article class="lead">
        <a class="lead-vis" href={lead.href} tabindex="-1" aria-hidden="true"><Visual item={lead} lang={lang} ratio="16 / 9" eager /></a>
        <div class="lead-txt">
          <div class="labels">
            <span class="kicker">{t.topStories}</span>
            <span class="label">{KIND_NAME[lead.kind][lang]} · {TOPIC_INFO[lead.topics[0]][lang]}</span>
          </div>
          <h2><a href={lead.href}>{lead.title}</a></h2>
          {lead.excerpt && <p class="standfirst">{lead.excerpt}</p>}
          <p class="byline-s">{t.by} <strong>{SITE.name}</strong> · <time datetime={lead.date.toISOString()}>{formatDate(lead.date, lang)}</time></p>
        </div>
      </article>
    )}

    <div class="second">
      {secondary.map((i) => <Card item={i} lang={lang} />)}
    </div>

    <aside class="rail">
      {reflections.length > 0 && (
        <section>
          <div class="rail-head"><h2>{t.commentary}</h2><a href={path.list(lang, 'commentary')}>{t.seeAll}</a></div>
          <ol class="quotes">
            {reflections.map((i) => (
              <li>
                <a href={i.href}>
                  <span class="q">{i.quote ? `“${i.quote.length > 140 ? i.quote.slice(0, 140).replace(/\s+\S*$/, '') + '…' : i.quote}”` : i.title}</span>
                  {i.author && <span class="who">{i.author}</span>}
                </a>
              </li>
            ))}
          </ol>
        </section>
      )}
      <section class="follow">
        <div class="rail-head"><h2>{t.followMe}</h2></div>
        <a class="f-li" href={SITE.linkedin} target="_blank" rel="me noopener">LinkedIn</a>
        <a class="f-x" href={SITE.x} target="_blank" rel="me noopener">X · @{SITE.xHandle}</a>
        <a class="f-nl" href="#newsletter">{t.subscribe}</a>
      </section>
    </aside>
  </section>

  <!-- Vidéos -->
  {videos.length > 0 && (
    <section class="section videos">
      <div class="wrap">
        <div class="section-head"><h2>{t.latestVideos}</h2><a class="more" href={path.list(lang, 'video')}>{t.seeAll}</a></div>
        <div class="grid4">{videos.map((i) => <Card item={i} lang={lang} />)}</div>
      </div>
    </section>
  )}

  <!-- Rubriques -->
  {sections.map((s) => (
    <section class="wrap topic-row">
      <div class="section-head rule"><h2>{TOPIC_INFO[s.tp][lang]}</h2><a class="more" href={path.topic(lang, s.tp)}>{t.moreIn} {TOPIC_INFO[s.tp][lang]}</a></div>
      <div class="grid4">{s.list.map((i) => <Card item={i} lang={lang} />)}</div>
    </section>
  ))}

  <!-- L'auteur -->
  <section class="section grey author">
    <div class="wrap about">
      <img src="/images/headshot.jpg" alt={SITE.name} width="640" height="800" loading="lazy" />
      <div>
        <span class="label">{t.aboutAuthor}</span>
        <h2>{SITE.name}</h2>
        <p class="bio">{p.apropos[0]}</p>
        <p class="bio">{p.apropos[1]}</p>
        <a class="btn btn-outline" href={path.about(lang)}>{t.moreAbout}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .ticker { border-bottom: 1px solid var(--line); background: var(--soft); }
  .ticker-in { display: flex; align-items: center; gap: 16px; min-height: 46px; overflow: hidden; }
  .tk-label { flex: none; font-size: 12px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--white); background: #B42318; padding: 4px 9px; border-radius: 3px; }
  .ticker ul { display: flex; gap: 28px; list-style: none; margin: 0; padding: 0; overflow-x: auto; scrollbar-width: none; white-space: nowrap; }
  .ticker ul::-webkit-scrollbar { display: none; }
  .ticker li { position: relative; font-size: 14px; font-weight: 600; }
  .ticker li + li::before { content: ""; position: absolute; left: -15px; top: 50%; width: 4px; height: 4px; border-radius: 50%; background: var(--faint); }
  .ticker a { text-decoration: none; color: var(--ink); }
  .ticker a:hover { color: var(--blue); text-decoration: underline; }

  .ed-head { padding-block: 36px 8px; display: grid; gap: 8px; }
  .ed-head h1 { font-size: clamp(34px, 5vw, 52px); font-weight: 800; letter-spacing: -0.03em; color: var(--navy); }
  .ed-head p { color: var(--muted); font-size: 18px; }

  .front { display: grid; gap: 36px; padding-block: 36px 56px; }
  .lead { display: grid; gap: 18px; align-content: start; }
  .labels { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; }
  .kicker { font-size: 12px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--white); background: var(--navy); padding: 4px 9px; border-radius: 3px; }
  .lead h2 { font-size: clamp(30px, 3.8vw, 46px); font-weight: 800; line-height: 1.08; letter-spacing: -0.03em; margin-top: 12px; }
  .lead h2 a { text-decoration: none; color: var(--navy); }
  .lead h2 a:hover { color: var(--blue); text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 5px; }
  .standfirst { font-size: 19px; line-height: 1.55; color: var(--muted); margin-top: 12px; }
  .byline-s { font-size: 14px; color: var(--faint); margin-top: 12px; }
  .byline-s strong { color: var(--ink); }
  .second { display: grid; gap: 32px; align-content: start; }
  .rail { display: grid; gap: 32px; align-content: start; }
  .rail-head { display: flex; justify-content: space-between; align-items: baseline; border-top: 3px solid var(--navy); padding-top: 10px; margin-bottom: 6px; }
  .rail-head h2 { font-size: 13px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }
  .rail-head a { font-size: 13px; color: var(--blue); text-decoration: none; font-weight: 600; }
  .quotes { list-style: none; margin: 0; padding: 0; }
  .quotes li { border-bottom: 1px solid var(--line); }
  .quotes a { display: grid; gap: 6px; padding-block: 14px; text-decoration: none; }
  .quotes .q { font-size: 16px; font-weight: 700; line-height: 1.4; color: var(--navy); }
  .quotes .who { font-size: 13px; color: var(--blue); font-weight: 600; }
  .quotes a:hover .q { color: var(--blue); }
  .follow { display: grid; gap: 8px; }
  .follow a { display: block; text-align: center; font-size: 14px; font-weight: 700; text-decoration: none; padding: 10px; border-radius: 4px; border: 1px solid #CBD5E1; color: var(--ink); }
  .follow a:hover { border-color: var(--ink); }
  .follow .f-li { background: #0A66C2; border-color: #0A66C2; color: #fff; }
  .follow .f-x { background: #0F1419; border-color: #0F1419; color: #fff; }
  @media (min-width: 760px) { .front { grid-template-columns: 1.7fr 1fr; } .rail { grid-column: 1 / -1; grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1100px) { .front { grid-template-columns: 1.75fr 1fr 0.95fr; gap: 40px; } .rail { grid-column: auto; grid-template-columns: 1fr; border-left: 1px solid var(--line); padding-left: 28px; } .second { border-left: 1px solid var(--line); padding-left: 28px; } }

  .videos { background: var(--navy); }
  .videos .section-head h2 { color: var(--white); }
  .videos .more { color: #8FB8E8; }
  .videos :global(h3 a) { color: var(--white); }
  .videos :global(.label), .videos :global(.date) { color: #A9C2DE; }
  .videos :global(.c:hover h3 a) { color: #8FB8E8; }

  .topic-row { padding-block: 44px 8px; }
  .topic-row .section-head h2 { font-size: 22px; }
  .grid4 { display: grid; gap: 32px 24px; grid-template-columns: 1fr; }
  @media (min-width: 620px) { .grid4 { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .grid4 { grid-template-columns: repeat(4, 1fr); } }

  .author { margin-top: 48px; }
  .about { display: grid; gap: 32px; align-items: center; }
  .about img { width: 100%; max-width: 240px; aspect-ratio: 1; object-fit: cover; object-position: 50% 6%; border-radius: 50%; }
  .about h2 { font-size: 30px; font-weight: 800; margin-top: 8px; color: var(--navy); }
  .bio { font-size: 18px; line-height: 1.65; margin-top: 12px; max-width: 44em; }
  .about .btn { margin-top: 20px; }
  @media (min-width: 760px) { .about { grid-template-columns: 240px 1fr; gap: 56px; } }
</style>
