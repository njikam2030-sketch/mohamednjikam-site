---
// Accueil (et éditions par région) à la manière des sites d'information économique :
// grande une en photo + liste illustrée, dernières publications, vidéos, réflexions, rubriques, rapports, l'auteur.
import Base from '../../layouts/Base.astro';
import Card from '../Card.astro';
import { SITE, TOPICS } from '../../config';
import { UI, TOPIC_INFO, REGION_NAME, formatDate, other, path, type Lang, type Region } from '../../i18n/ui';
import { allItems, type Item } from '../../lib/content';
import profil from '../../data/profil.json';

interface Props { lang: Lang; edition?: Region }
const { lang, edition } = Astro.props;
const t = UI[lang];
const p = profil[lang];
const everything = (await allItems(lang)).filter((i) => !i.coming);
const items = edition ? everything.filter((i) => i.topics.includes(edition)) : everything;

const used = new Set<Item>();
const take = (list: Item[], n: number) => { const out = list.filter((i) => !used.has(i)).slice(0, n); out.forEach((i) => used.add(i)); return out; };
const analyses = items.filter((i) => i.kind === 'analysis');
const lead = take([...analyses.filter((i) => i.featured), ...analyses, ...items.filter((i) => i.kind !== 'video')], 1)[0];
const side = take(items.filter((i) => i.kind !== 'video'), 4);
const latest = take(items.filter((i) => i.kind !== 'video' && i.kind !== 'commentary'), 4);
const videos = items.filter((i) => i.kind === 'video').slice(0, 4);
const reflections = items.filter((i) => i.kind === 'commentary' && !used.has(i)).slice(0, 3);
reflections.forEach((i) => used.add(i));
const reports = items.filter((i) => i.kind === 'report').slice(0, 2);
// Une rubrique = une grande carte + des titres illustrés, seulement avec des publications pas encore affichées
// (au moins trois, dont une analyse, un graphique ou un rapport en tête), pour ne jamais répéter la page.
const blocks: { tp: (typeof TOPICS)[number]; list: Item[] }[] = [];
const rank = (i: Item) => ({ analysis: 0, report: 1, chart: 2, commentary: 3, video: 4 })[i.kind];
for (const tp of TOPICS.filter((x) => x !== edition)) {
  const list = everything.filter((i) => i.topics.includes(tp) && i.kind !== 'video' && !used.has(i)).sort((x, y) => rank(x) - rank(y)).slice(0, 4);
  if (list.length >= 3 && list[0].kind !== 'commentary' && blocks.length < 3) { blocks.push({ tp, list }); list.forEach((i) => used.add(i)); }
}
const title = edition ? `${REGION_NAME[edition][lang]} ${t.edition}` : undefined;
const alt = edition ? path.edition(other(lang), edition) : path.home(other(lang));
const short = (x: string, n = 150) => (x.length > n ? x.slice(0, n).replace(/\s+\S*$/, '') + '…' : x);
---
<Base lang={lang} title={title} section="home" edition={edition} alternate={alt}>

  {edition && (
    <div class="wrap ed-head">
      <span class="pill">{t.edition}</span>
      <h1>{TOPIC_INFO[edition][lang]}</h1>
      <p>{lang === 'fr' ? TOPIC_INFO[edition].dfr : TOPIC_INFO[edition].den}</p>
    </div>
  )}

  <!-- La une -->
  <section class="wrap front">
    {!lead && <p class="empty">{t.emptyHome}</p>}
    {lead && (
      <article class="hero">
        <img src={lead.thumb} alt="" loading="eager" fetchpriority="high" />
        <div class="hero-txt">
          {lead.topics[0] && <a class="pill" href={path.topic(lang, lead.topics[0])}>{TOPIC_INFO[lead.topics[0]][lang]}</a>}
          <h1><a href={lead.href}>{lead.title}</a></h1>
          {lead.excerpt && <p class="hero-ex">{lead.excerpt}</p>}
          <p class="hero-meta"><span>{SITE.name}</span><span><time datetime={lead.date.toISOString()}>{formatDate(lead.date, lang)}</time></span></p>
        </div>
      </article>
    )}
    {side.length > 0 && <div class="side-list">{side.map((i) => <Card item={i} lang={lang} variant="side" />)}</div>}
  </section>

  <!-- Dernières publications -->
  {latest.length > 0 && (
    <section class="wrap block">
      <div class="section-head"><h2>{t.latest}</h2><a class="more" href={path.list(lang, 'analysis')}>{t.seeAll}</a></div>
      <div class="grid4" style={`--n:${latest.length}`}>{latest.map((i) => <Card item={i} lang={lang} />)}</div>
    </section>
  )}

  <!-- Vidéos -->
  {videos.length > 0 && (
    <section class="videos">
      <div class="wrap">
        <div class="section-head"><h2>{t.latestVideos}</h2><a class="more" href={path.list(lang, 'video')}>{t.seeAll}</a></div>
        <div class="grid4">{videos.map((i) => <Card item={i} lang={lang} />)}</div>
      </div>
    </section>
  )}

  <!-- Réflexions -->
  {reflections.length > 0 && (
    <section class="wrap block">
      <div class="section-head"><h2>{t.commentary}</h2><a class="more" href={path.list(lang, 'commentary')}>{t.seeAll}</a></div>
      <div class="quotes">
        {reflections.map((i) => (
          <a class="q" href={i.href}>
            <span class="qmark" aria-hidden="true">“</span>
            <span class="qtext">{i.quote ? short(i.quote) : short(i.title)}</span>
            <span class="qwho">
              {i.author ? <span>{i.author}</span> : <span class="me"><img src="/images/avatar.jpg" alt="" width="28" height="28" />{SITE.name}</span>}
            </span>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Rubriques -->
  {blocks.map((b) => (
    <section class="wrap block">
      <div class="section-head"><h2>{TOPIC_INFO[b.tp][lang]}</h2><a class="more" href={path.topic(lang, b.tp)}>{t.seeAll}</a></div>
      <div class="topic-block">
        <Card item={b.list[0]} lang={lang} />
        <div class="topic-side">{b.list.slice(1).map((i) => <Card item={i} lang={lang} variant="side" />)}</div>
      </div>
    </section>
  ))}

  <!-- Rapports -->
  {reports.length > 0 && (
    <section class="wrap block">
      <div class="section-head"><h2>{t.reports}</h2><a class="more" href={path.list(lang, 'report')}>{t.seeAll}</a></div>
      <div class="reports">
        {reports.map((r) => (
          <article class="rep">
            <a class="rep-cover" href={r.href} tabindex="-1" aria-hidden="true"><img src={r.image} alt="" loading="lazy" /></a>
            <div class="rep-txt">
              <span class="pill">{t.reports}</span>
              <h3><a href={r.href}>{r.title}</a></h3>
              {r.excerpt && <p>{r.excerpt}</p>}
              <div class="rep-act">
                {r.pdf && <a class="btn btn-primary" href={r.pdf} download>{t.downloadPdf}</a>}
                <a class="btn btn-outline" href={r.href}>{t.readAnalysis}</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>
  )}

  <!-- L'auteur -->
  <section class="wrap block last">
    <div class="author">
      <img src="/images/headshot.jpg" alt={SITE.name} width="640" height="800" loading="lazy" />
      <div>
        <span class="pill">{t.aboutAuthor}</span>
        <h2>{SITE.name}</h2>
        <p class="bio">{p.apropos[0]}</p>
        <div class="links">
          <a class="btn btn-primary" href={path.about(lang)}>{t.moreAbout}</a>
          <a class="btn btn-outline" href={SITE.linkedin} target="_blank" rel="me noopener">LinkedIn</a>
          <a class="btn btn-outline" href={SITE.x} target="_blank" rel="me noopener">X · @{SITE.xHandle}</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .ed-head { padding-top: 30px; display: grid; gap: 8px; justify-items: start; }
  .ed-head h1 { font-size: clamp(30px, 4.5vw, 44px); color: var(--navy); }
  .ed-head p { color: var(--muted); font-size: 18px; }

  .front { display: grid; gap: 24px; padding-top: 28px; }
  .hero { position: relative; display: flex; align-items: flex-end; min-height: 440px; border-radius: 12px; overflow: hidden; background: var(--navy); isolation: isolate; }
  .hero img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; transition: transform 0.6s ease; }
  .hero::before { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(to top, rgba(6, 26, 46, 0.95) 0%, rgba(6, 26, 46, 0.7) 40%, rgba(6, 26, 46, 0.05) 75%); }
  .hero:hover img { transform: scale(1.03); }
  .hero-txt { display: grid; gap: 14px; justify-items: start; padding: 28px; color: var(--white); }
  .hero h1 { font-size: clamp(26px, 3.2vw, 38px); line-height: 1.15; color: var(--white); }
  .hero h1 a { color: inherit; text-decoration: none; }
  .hero h1 a::after { content: ""; position: absolute; inset: 0; }
  .hero:hover h1 a { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 6px; }
  .hero .pill { position: relative; z-index: 1; }
  .hero-ex { font-size: 17px; line-height: 1.5; color: #D6E1EE; max-width: 44em; }
  .hero-meta { display: flex; flex-wrap: wrap; gap: 6px 18px; font-size: 14px; color: #C7D2E0; }
  .hero-meta span:first-child { font-weight: 700; color: var(--white); }
  .side-list { display: grid; gap: 20px; align-content: start; }
  @media (min-width: 1040px) {
    .front { grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 30px; }
    .hero { min-height: 560px; }
    .hero-txt { padding: 36px 40px; }
    .side-list { gap: 0; }
    .side-list > :global(*) { padding-block: 16px; border-bottom: 1px solid var(--line); }
    .side-list > :global(*:first-child) { padding-top: 0; }
    .side-list > :global(*:last-child) { border-bottom: 0; }
  }

  .block { padding-top: 52px; }
  .block.last { padding-bottom: 60px; }
  .grid4 { display: grid; gap: 28px 24px; grid-template-columns: 1fr; }
  @media (min-width: 620px) { .grid4 { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .grid4 { grid-template-columns: repeat(var(--n, 4), 1fr); } }

  .videos { margin-top: 56px; padding-block: 44px 52px; background: var(--navy); }
  .videos .section-head h2 { color: var(--white); }
  .videos .section-head h2::before { background: var(--red); }
  .videos .more { color: #8FB8E8; }
  .videos :global(h3 a) { color: var(--white); }
  .videos :global(.c:hover h3 a) { color: #BFD8F5; }
  .videos :global(.date), .videos :global(.kind) { color: #A9BCD3; }

  .quotes { display: grid; gap: 20px; }
  .q { position: relative; display: grid; gap: 14px; align-content: space-between; padding: 26px 26px 22px; border-radius: 12px; background: var(--soft); text-decoration: none; border: 1px solid transparent; transition: border-color 0.2s, background 0.2s; }
  .q:hover { background: var(--white); border-color: var(--primary); }
  .qmark { font-family: Georgia, "Times New Roman", serif; font-size: 72px; line-height: 0.6; font-weight: 700; color: var(--primary); height: 30px; }
  .qtext { font-size: 19px; font-weight: 700; line-height: 1.4; color: var(--navy); }
  .qwho { font-size: 13.5px; color: var(--muted); font-weight: 600; }
  .me { display: inline-flex; align-items: center; gap: 8px; }
  .me img { width: 28px; height: 28px; border-radius: 50%; object-fit: cover; }
  @media (min-width: 860px) { .quotes { grid-template-columns: repeat(3, 1fr); } }

  .topic-block { display: grid; gap: 24px; }
  .topic-block > :global(.card h3) { font-size: 24px; }
  .topic-block > :global(.card .vis) { aspect-ratio: 16 / 9 !important; }
  .topic-side { display: grid; gap: 18px; align-content: start; }
  @media (min-width: 900px) { .topic-block { grid-template-columns: 1.15fr 1fr; gap: 32px; } }

  .reports { display: grid; gap: 24px; }
  .rep { display: grid; gap: 22px; padding: 22px; border-radius: 12px; background: var(--soft); align-items: center; }
  .rep-cover { display: block; }
  .rep-cover img { width: 150px; aspect-ratio: 210 / 297; object-fit: cover; border-radius: 4px; box-shadow: 0 10px 24px rgba(15, 23, 42, 0.2); }
  .rep-txt { display: grid; gap: 10px; justify-items: start; }
  .rep h3 { font-size: 22px; }
  .rep h3 a { text-decoration: none; color: var(--navy); }
  .rep h3 a:hover { color: var(--primary); text-decoration: underline; }
  .rep p { color: var(--muted); }
  .rep-act { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 6px; }
  @media (min-width: 640px) { .rep { grid-template-columns: 150px 1fr; gap: 28px; } }
  @media (min-width: 1100px) { .reports:has(.rep + .rep) { grid-template-columns: 1fr 1fr; } }

  .author { display: grid; gap: 24px; align-items: center; padding: 28px; border-radius: 12px; background: linear-gradient(120deg, var(--navy), #12395F); color: var(--white); }
  .author img { width: 140px; height: 140px; object-fit: cover; object-position: 50% 8%; border-radius: 50%; border: 4px solid rgba(255, 255, 255, 0.15); }
  .author h2 { font-size: 30px; color: var(--white); margin-top: 10px; }
  .bio { font-size: 17px; line-height: 1.65; margin-top: 10px; max-width: 52em; color: #D6E1EE; }
  .links { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 18px; }
  .author .btn-outline { color: var(--white); border-color: rgba(255, 255, 255, 0.35); }
  .author .btn-outline:hover { border-color: var(--white); }
  @media (min-width: 760px) { .author { grid-template-columns: 140px 1fr; gap: 36px; padding: 36px 40px; } }
</style>
