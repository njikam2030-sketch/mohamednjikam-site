---
// Accueil (et éditions par région) composé comme la une d'un quotidien économique :
// grand article, articles secondaires, colonne de réflexions, vidéos, rapports, rubriques, l'auteur.
import Base from '../../layouts/Base.astro';
import Card from '../Card.astro';
import Visual from '../Visual.astro';
import { SITE, TOPICS } from '../../config';
import { UI, TOPIC_INFO, REGION_NAME, formatDate, other, path, type Lang, type Region } from '../../i18n/ui';
import { allItems, type Item } from '../../lib/content';
import profil from '../../data/profil.json';

interface Props { lang: Lang; edition?: Region }
const { lang, edition } = Astro.props;
const t = UI[lang];
const p = profil[lang];
const everything = await allItems(lang);
const items = edition ? everything.filter((i) => i.topics.includes(edition)) : everything;

const analyses = items.filter((i) => i.kind === 'analysis');
const lead = analyses.find((i) => i.featured) ?? analyses[0] ?? items.find((i) => i.kind !== 'video') ?? items[0];
const secondary = items.filter((i) => i !== lead && (i.kind === 'analysis' || i.kind === 'chart' || i.kind === 'report')).slice(0, 3);
const reflections = items.filter((i) => i.kind === 'commentary').slice(0, 6);
const videos = items.filter((i) => i.kind === 'video').slice(0, 4);
const reports = items.filter((i) => i.kind === 'report').slice(0, 3);
// Rubriques : quelques titres par rubrique, sans vignette (comme les colonnes de bas de une)
// sans répéter ce qui est déjà à la une ni d'une colonne à l'autre ; les citations restent dans leur colonne
const used = new Set<Item>([lead, ...secondary].filter(Boolean));
const sections: { tp: (typeof TOPICS)[number]; list: Item[] }[] = [];
for (const tp of TOPICS.filter((x) => x !== edition)) {
  const list = items.filter((i) => i.topics.includes(tp) && i.kind !== 'video' && !(i.kind === 'commentary' && i.quote) && !used.has(i)).slice(0, 3);
  list.forEach((i) => used.add(i));
  if (list.length > 0) sections.push({ tp, list });
}
const title = edition ? `${REGION_NAME[edition][lang]} ${t.edition}` : undefined;
const alt = edition ? path.edition(other(lang), edition) : path.home(other(lang));
const short = (x: string, n = 130) => (x.length > n ? x.slice(0, n).replace(/\s+\S*$/, '') + '…' : x);
---
<Base lang={lang} title={title} section="home" edition={edition} alternate={alt}>

  {edition && (
    <div class="wrap ed-head">
      <span class="label">{t.edition}</span>
      <h1>{TOPIC_INFO[edition][lang]}</h1>
      <p>{lang === 'fr' ? TOPIC_INFO[edition].dfr : TOPIC_INFO[edition].den}</p>
    </div>
  )}

  <!-- La une -->
  <section class="wrap front">
    {!lead && <p class="empty">{t.emptyHome}</p>}
    {lead && (
      <div class="main">
        <article class="lead">
          <div class="lead-txt">
            <span class="label">{TOPIC_INFO[lead.topics[0]]?.[lang] ?? t.topStories}</span>
            <h2><a href={lead.href}>{lead.title}</a></h2>
            {lead.excerpt && <p class="standfirst">{lead.excerpt}</p>}
            <p class="byline">{t.by} <strong>{SITE.name}</strong> · <time datetime={lead.date.toISOString()}>{formatDate(lead.date, lang)}</time></p>
          </div>
          {lead.image && <a class="lead-vis" href={lead.href} tabindex="-1" aria-hidden="true"><Visual item={lead} ratio={lead.image.includes('/charts/') ? 'auto' : '4 / 3'} eager /></a>}
        </article>
        {secondary.length > 0 && (
          <div class="second">{secondary.map((i) => <Card item={i} lang={lang} />)}</div>
        )}
      </div>
    )}

    {reflections.length > 0 && (
      <aside class="rail">
        <div class="rail-head"><h2>{t.commentary}</h2><a href={path.list(lang, 'commentary')}>{t.seeAll}</a></div>
        <ol class="quotes">
          {reflections.map((i) => (
            <li>
              <a href={i.href}>
                <span class:list={['q', { it: !!i.quote }]}>{i.quote ? `“${short(i.quote)}”` : short(i.title)}</span>
                <span class="who">{i.author ?? SITE.name}</span>
              </a>
            </li>
          ))}
        </ol>
      </aside>
    )}
  </section>

  <!-- Vidéos -->
  {videos.length > 0 && (
    <section class="wrap block">
      <div class="section-head"><h2>{t.latestVideos}</h2><a class="more" href={path.list(lang, 'video')}>{t.seeAll}</a></div>
      <div class="grid4">{videos.map((i) => <Card item={i} lang={lang} />)}</div>
    </section>
  )}

  <!-- Rapports -->
  {reports.length > 0 && (
    <section class="wrap block">
      <div class="section-head"><h2>{t.reports}</h2><a class="more" href={path.list(lang, 'report')}>{t.seeAll}</a></div>
      <div class:list={['reports', { one: reports.length === 1 }]}>
        {reports.map((r) => (
          <article class="rep">
            <a class="rep-cover" href={r.href} tabindex="-1" aria-hidden="true"><img src={r.image} alt="" loading="lazy" /></a>
            <div>
              <span class="label">{t.reports}</span>
              <h3><a href={r.href}>{r.title}</a></h3>
              {r.excerpt && <p>{r.excerpt}</p>}
              <div class="rep-act">
                {r.pdf && <a href={r.pdf} download>{t.downloadPdf}</a>}
                <time class="date" datetime={r.date.toISOString()}>{formatDate(r.date, lang)}</time>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>
  )}

  <!-- Rubriques -->
  {sections.length > 0 && (
    <section class="wrap block">
      <div class="cols" style={`--n:${Math.min(sections.length, 4)}`}>
        {sections.map((s) => (
          <section class="col">
            <h2><a href={path.topic(lang, s.tp)}>{TOPIC_INFO[s.tp][lang]}</a></h2>
            {s.list.map((i) => <Card item={i} lang={lang} variant="compact" meta={false} />)}
          </section>
        ))}
      </div>
    </section>
  )}

  <!-- L'auteur -->
  <section class="wrap block">
    <div class="author">
      <img src="/images/headshot.jpg" alt={SITE.name} width="640" height="800" loading="lazy" />
      <div>
        <span class="label">{t.aboutAuthor}</span>
        <h2>{SITE.name}</h2>
        <p class="bio">{p.apropos[0]}</p>
        <p class="links"><a href={path.about(lang)}>{t.moreAbout}</a><a href={SITE.linkedin} target="_blank" rel="me noopener">LinkedIn</a><a href={SITE.x} target="_blank" rel="me noopener">X · @{SITE.xHandle}</a></p>
      </div>
    </div>
  </section>
</Base>

<style>
  .ed-head { padding-block: 32px 0; display: grid; gap: 6px; }
  .ed-head h1 { font-size: clamp(34px, 5vw, 50px); }
  .ed-head p { font-family: var(--serif); color: var(--muted); font-size: 19px; }

  .front { display: grid; gap: 36px; padding-block: 28px 8px; }
  .main { display: grid; gap: 28px; align-content: start; min-width: 0; }
  .lead { display: grid; gap: 22px; padding-bottom: 28px; border-bottom: 1px solid var(--line); }
  .lead-txt { display: grid; gap: 12px; align-content: start; }
  .lead h2 { font-size: clamp(32px, 3.6vw, 46px); line-height: 1.08; letter-spacing: -0.015em; }
  .lead h2 a { text-decoration: none; color: var(--ink); }
  .lead h2 a:hover { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 5px; }
  .standfirst { font-family: var(--serif); font-size: 20px; line-height: 1.45; color: var(--muted); }
  .byline { font-size: 13px; color: var(--faint); }
  .byline strong { color: var(--ink); font-weight: 600; }
  .second { display: grid; gap: 24px; }
  .second > :global(*) { padding-bottom: 20px; border-bottom: 1px solid var(--line); }
  .second :global(h3) { font-size: 20px; }
  @media (min-width: 760px) {
    .lead { grid-template-columns: 1fr 1.05fr; gap: 28px; align-items: start; }
    .second { grid-template-columns: repeat(3, 1fr); gap: 0; }
    .second > :global(*) { padding: 0 20px; border-bottom: 0; border-left: 1px solid var(--line); }
    .second > :global(*:first-child) { padding-left: 0; border-left: 0; }
  }

  .rail { min-width: 0; }
  .rail-head { display: flex; justify-content: space-between; align-items: baseline; border-top: 2px solid var(--rule); padding-top: 9px; }
  .rail-head h2 { font-size: 20px; }
  .rail-head a { font-size: 13px; color: var(--ink); text-decoration: none; font-weight: 600; }
  .rail-head a:hover { text-decoration: underline; }
  .quotes { list-style: none; margin: 0; padding: 0; }
  .quotes li { border-bottom: 1px solid var(--line); }
  .quotes a { display: grid; gap: 6px; padding-block: 14px; text-decoration: none; }
  .quotes .q { font-family: var(--serif); font-size: 17.5px; font-weight: 600; line-height: 1.32; color: var(--ink); }
  .quotes .q.it { font-style: italic; }
  .quotes .who { font-size: 12.5px; color: var(--faint); }
  .quotes a:hover .q { text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
  @media (min-width: 1060px) {
    .front { grid-template-columns: minmax(0, 1fr) 300px; gap: 0; }
    .main { padding-right: 32px; }
    .rail { padding-left: 28px; border-left: 1px solid var(--line); }
  }

  .block { padding-top: 44px; }
  .grid4 { display: grid; gap: 28px 24px; grid-template-columns: 1fr; }
  .grid4 :global(h3) { font-size: 18px; }
  @media (min-width: 620px) { .grid4 { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .grid4 { grid-template-columns: repeat(4, 1fr); } }

  .reports { display: grid; gap: 28px; }
  .rep { display: grid; grid-template-columns: 110px 1fr; gap: 18px; align-items: start; }
  .rep-cover img { width: 110px; aspect-ratio: 210 / 297; object-fit: cover; box-shadow: 0 1px 2px rgba(0,0,0,.12), 0 6px 16px rgba(0,0,0,.08); }
  .rep h3 { font-size: 20px; margin-top: 6px; }
  .rep h3 a { text-decoration: none; }
  .rep h3 a:hover { text-decoration: underline; }
  .rep p { font-size: 15px; color: var(--muted); margin-top: 6px; }
  .rep-act { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 16px; margin-top: 10px; }
  .rep-act a { font-size: 14px; font-weight: 600; color: var(--blue); }
  @media (min-width: 900px) { .reports { grid-template-columns: repeat(2, 1fr); gap: 36px; } .reports.one { grid-template-columns: 1fr; } .one .rep { grid-template-columns: 150px minmax(0, 640px); gap: 26px; } .one .rep-cover img { width: 150px; } .one .rep h3 { font-size: 26px; } }

  .cols { display: grid; gap: 32px 28px; grid-template-columns: 1fr; }
  .col h2 { font-size: 19px; border-top: 2px solid var(--rule); padding-top: 9px; margin-bottom: 2px; }
  .col h2 a { text-decoration: none; }
  .col h2 a:hover { text-decoration: underline; }
  .col :global(.compact:last-child) { border-bottom: 0; }
  @media (min-width: 620px) { .cols { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .cols { grid-template-columns: repeat(var(--n), 1fr); } }

  .author { display: grid; gap: 24px; align-items: center; border-top: 2px solid var(--rule); padding-block: 28px 56px; }
  .author img { width: 120px; height: 120px; object-fit: cover; object-position: 50% 8%; border-radius: 50%; }
  .author h2 { font-size: 28px; margin-top: 6px; }
  .bio { font-family: var(--serif); font-size: 18px; line-height: 1.6; margin-top: 10px; max-width: 46em; color: var(--muted); }
  .links { display: flex; flex-wrap: wrap; gap: 6px 22px; margin-top: 14px; font-size: 14px; font-weight: 600; }
  .links a { color: var(--ink); text-underline-offset: 3px; }
  .links a:hover { color: var(--blue); }
  @media (min-width: 760px) { .author { grid-template-columns: 120px 1fr; gap: 32px; } }
</style>
