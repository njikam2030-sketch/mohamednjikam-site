---
// Liste des analyses, toutes ou d'une rubrique : la plus récente en grand, puis les autres.
import Base from '../../layouts/Base.astro';
import AnalysisCard from '../AnalysisCard.astro';
import Newsletter from '../Newsletter.astro';
import { TOPICS, type Topic } from '../../config';
import { UI, TOPIC_NAMES, path, type Lang } from '../../i18n/ui';
import { getAnalysesFor } from '../../lib/content';

interface Props { lang: Lang; topic?: Topic }
const { lang, topic } = Astro.props;
const t = UI[lang];
const other: Lang = lang === 'en' ? 'fr' : 'en';
const all = await getAnalysesFor(lang);
const list = topic ? all.filter((a) => a.data.rubrique === topic || a.data.rubrique2 === topic) : all;
const [first, ...rest] = list;
const heading = topic ? TOPIC_NAMES[topic][lang] : t.analysis;
---
<Base lang={lang} title={heading} section="analysis" alternate={topic ? path.topic(other, topic) : path.analyses(other)}>
  <main class="gutter">
    <div class="wide">
      <header class="top">
        {topic && <a class="meta up" href={path.analyses(lang)}>{t.allAnalysis}</a>}
        <h1>{heading}</h1>
        <nav class="topics" aria-label={t.topics}>
          {TOPICS.map((tp) => <a href={path.topic(lang, tp)} aria-current={tp === topic ? 'page' : undefined}>{TOPIC_NAMES[tp][lang]}</a>)}
        </nav>
      </header>
      {list.length === 0 && <p class="empty">{topic ? t.noTopic : t.noAnalysis}</p>}
      {first && <div class="lead"><AnalysisCard entry={first} lang={lang} size="large" /></div>}
      {rest.length > 0 && <div class="grid">{rest.map((a) => <AnalysisCard entry={a} lang={lang} />)}</div>}
      <div class="nl"><Newsletter lang={lang} /></div>
    </div>
  </main>
</Base>

<style>
  .top { display: grid; gap: 14px; padding-block: 32px 24px; border-bottom: 3px solid var(--ink); margin-bottom: 28px; }
  .up { text-decoration: none; font-weight: 600; } .up:hover { color: var(--accent); }
  h1 { font-size: clamp(34px, 6vw, 56px); font-weight: 900; letter-spacing: -0.04em; }
  .topics { display: flex; flex-wrap: wrap; gap: 8px; }
  .topics a { font-size: 14px; font-weight: 600; text-decoration: none; color: var(--brown); border: 1px solid var(--line); background: var(--paper); border-radius: 999px; padding: 5px 12px; }
  .topics a:hover, .topics a[aria-current] { border-color: var(--ink); background: var(--ink); color: var(--cream); }
  .lead { padding-bottom: 32px; border-bottom: 1px solid var(--line); margin-bottom: 32px; }
  .lead :global(.card) { gap: 18px; }
  @media (min-width: 860px) { .lead :global(.card) { grid-template-columns: 1.4fr 1fr; align-items: center; gap: 36px; } }
  .grid { display: grid; gap: 32px; grid-template-columns: 1fr; }
  @media (min-width: 620px) { .grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 960px) { .grid { grid-template-columns: repeat(3, 1fr); } }
  .nl { margin-top: 48px; }
</style>
