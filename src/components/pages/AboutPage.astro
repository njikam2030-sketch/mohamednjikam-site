---
// À propos : photo, présentation (modifiable dans l'espace admin), repères, liens.
import Base from '../../layouts/Base.astro';
import PageHead from '../PageHead.astro';
import { SITE } from '../../config';
import { UI, other, path, type Lang } from '../../i18n/ui';
import profil from '../../data/profil.json';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = UI[lang];
const p = profil[lang];
---
<Base lang={lang} title={t.about} description={`${p.titre}. ${p.bio}`} section="about" alternate={path.about(other(lang))}>
  <PageHead lang={lang} title="Mohamed Njikam" intro={p.role} />
  <section class="section">
    <div class="wrap about">
      <img class="photo" src="/images/portrait.jpg" alt="Mohamed Njikam" width="640" height="800" />
      <div class="text">
        <p class="lead">{p.titre}. {p.bio}</p>
        {p.apropos.map((x) => <p>{x}</p>)}
        <dl class="facts">
          <div><dt>{t.basedIn}</dt><dd>{p.ville}</dd></div>
          <div><dt>{t.education}</dt><dd>{p.formation}</dd></div>
          <div><dt>{t.writesIn}</dt><dd>{t.writesInV}</dd></div>
        </dl>
        <div class="links">
          <a class="btn btn-primary" href={SITE.linkedin} target="_blank" rel="me noopener">LinkedIn</a>
          <a class="btn btn-outline" href={SITE.x} target="_blank" rel="me noopener">X · @{SITE.xHandle}</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .about { display: grid; gap: 40px; align-items: start; }
  .photo { width: 100%; max-width: 380px; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 0; border-radius: 4px; }
  .text { max-width: 680px; }
  .text > p { font-size: 18px; line-height: 1.7; }
  .text > p + p { margin-top: 1em; }
  .lead { font-size: 22px !important; line-height: 1.5 !important; font-weight: 600; color: var(--navy); }
  .facts { margin: 32px 0 0; border-top: 1px solid var(--line); }
  .facts div { display: grid; grid-template-columns: 140px 1fr; gap: 12px; padding-block: 12px; border-bottom: 1px solid var(--line); font-size: 16px; }
  .facts dt { color: var(--faint); font-weight: 500; }
  .facts dd { margin: 0; }
  .links { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 28px; }
  @media (min-width: 860px) { .about { grid-template-columns: 380px 1fr; gap: 64px; } }
</style>
