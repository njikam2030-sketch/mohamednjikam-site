---
// Partage : LinkedIn, X, WhatsApp, email, copier le lien.
import { SITE } from '../config';
import { UI, type Lang } from '../i18n/ui';

interface Props { lang: Lang; url: string; text: string }
const { lang, url, text } = Astro.props;
const t = UI[lang];
const u = encodeURIComponent(url);
const tx = encodeURIComponent(text);
const links = [
  { name: 'LinkedIn', href: `https://www.linkedin.com/sharing/share-offsite/?url=${u}` },
  { name: 'X', href: `https://x.com/intent/post?text=${tx}&url=${u}&via=${SITE.xHandle}` },
  { name: 'WhatsApp', href: `https://wa.me/?text=${tx}%20${u}` },
  { name: 'Email', href: `mailto:?subject=${tx}&body=${u}` },
];
---
<div class="share">
  <span>{t.share}</span>
  {links.map((l) => <a href={l.href} target="_blank" rel="noopener">{l.name}</a>)}
  <button type="button" data-copy={url} data-done={t.copied}>{t.copy}</button>
</div>

<style>
  .share { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  span { font-size: 14px; font-weight: 700; margin-right: 6px; }
  a, button { font: 500 14px var(--font); color: var(--ink); text-decoration: none; background: var(--white); border: 1px solid #CBD5E1; border-radius: 4px; padding: 7px 14px; cursor: pointer; }
  a:hover, button:hover { border-color: var(--blue); color: var(--blue); }
</style>
