---
// Fiche d'une publication. Trois présentations :
// « card » (vignette + texte, pour les grilles), « row » (ligne avec date, pour les listes), « compact » (titre et date).
import { UI, KIND_NAME, TOPIC_INFO, formatDate, type Lang } from '../i18n/ui';
import type { Item } from '../lib/content';
import Visual from './Visual.astro';

interface Props { item: Item; lang: Lang; variant?: 'card' | 'row' | 'compact' }
const { item, lang, variant = 'card' } = Astro.props;
const t = UI[lang];
const topic = item.topics[0];
---
<article class:list={['c', variant]}>
  {variant === 'card' && <a class="v" href={item.href} tabindex="-1" aria-hidden="true"><Visual item={item} lang={lang} /></a>}
  {variant === 'row' && <time class="date col" datetime={item.date.toISOString()}>{formatDate(item.date, lang)}</time>}
  <div class="txt">
    <div class="meta-line">
      <span class="label label-kind">{KIND_NAME[item.kind][lang]}</span>
      {topic && <span class="label">{TOPIC_INFO[topic][lang]}</span>}
      {item.kind === 'video' && (item.mine ? <span class="badge">{t.myVideo}</span> : item.channel && <span class="date">{item.channel}</span>)}
      {item.lang !== lang && <span class="badge">{item.lang.toUpperCase()}</span>}
      {item.coming && <span class="badge">{t.coming}</span>}
    </div>
    <h3><a href={item.href}>{item.title}</a></h3>
    {variant !== 'compact' && item.excerpt && <p class="ex">{item.excerpt}</p>}
    {variant !== 'row' && <time class="date" datetime={item.date.toISOString()}>{formatDate(item.date, lang)}</time>}
  </div>
</article>

<style>
  .c { position: relative; min-width: 0; }
  .v { display: block; text-decoration: none; color: inherit; }
  .txt { display: grid; gap: 8px; min-width: 0; align-content: start; }
  .meta-line { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 12px; }
  h3 a { text-decoration: none; color: var(--ink); }
  h3 a::after { content: ""; position: absolute; inset: 0; }
  .c:hover h3 a { color: var(--blue); text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
  .ex { color: var(--muted); font-size: 16px; line-height: 1.55; }

  .card { display: grid; gap: 16px; align-content: start; }
  .card h3 { font-size: 20px; font-weight: 700; line-height: 1.3; }

  .row { display: grid; gap: 6px; padding-block: 22px; border-bottom: 1px solid var(--line); }
  .row h3 { font-size: 21px; font-weight: 700; line-height: 1.3; }
  .row .col { padding-top: 2px; }
  @media (min-width: 720px) { .row { grid-template-columns: 170px 1fr; gap: 24px; } }

  .compact { padding-block: 14px; border-bottom: 1px solid var(--line); }
  .compact h3 { font-size: 17px; font-weight: 700; line-height: 1.35; }
  .compact .txt { gap: 5px; }
</style>
